# RAMVORA API configuration reference.
#
# Copy to `.env` for local development only (`.env` is git-ignored).
# NEVER commit real values. On Render, set secrets in the service's
# Environment settings, not in this file or render.yaml.
#
# Required = the related feature returns HTTP 503 until it is set.

# --- Core --------------------------------------------------------------
# SQLite file. On Render this must live on the persistent disk.
DATABASE_PATH=data/invoice_api.db
# Required for the admin API. At least 32 random characters. (Render generates one.)
API_ADMIN_KEY=
# Comma-separated browser origins allowed to call the API, e.g. https://app.example.com
CORS_ORIGINS=
# Proxies in front of the app; Render = 1. Used for real client IP (rate limits, allowlist).
TRUSTED_PROXY_HOPS=1

# --- Admin API (see ADMIN_GUIDE.md) --------------------------------------
# API_ADMIN_KEY above must be at least 32 characters.
# Strongly recommended: IPs/CIDRs allowed to reach /v1/admin (others get 404).
ADMIN_ALLOWED_IPS=
# ADMIN_AUTH_FAILURE_LIMIT=10
# ADMIN_RATE_LIMIT=300

# --- Stripe billing (use sk_test_ keys for staging) ---------------------
# Required for checkout, portal, recovery, account deletion with billing, webhooks.
STRIPE_SECRET_KEY=
# Required for /v1/billing/webhook. From the Stripe webhook endpoint you create (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Required: recurring monthly price IDs (price_...). See STRIPE_SANDBOX_TEST_PLAN.md.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_BUSINESS=
# Required for checkout / customer portal redirects (https URLs you control).
CHECKOUT_SUCCESS_URL=
CHECKOUT_CANCEL_URL=
CUSTOMER_PORTAL_RETURN_URL=
# Monthly page allowances per plan.
PLAN_STARTER_MONTHLY_LIMIT=1000
PLAN_PROFESSIONAL_MONTHLY_LIMIT=5000
PLAN_BUSINESS_MONTHLY_LIMIT=20000
# Hours a past_due subscription keeps API access.
PAYMENT_GRACE_HOURS=72

# --- API key encryption + email delivery (required before paid signup) ---
# Fernet key. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back it up securely: losing it makes undelivered encrypted keys unreadable.
API_KEY_ENCRYPTION_KEY=
# Resend API key and a sender on a domain verified in Resend.
RESEND_API_KEY=
FROM_EMAIL=RAMVORA <no-reply@example.com>

# --- AI extraction engine (DISABLED until the owner authorises paid AI use) ---
# Must stay false until testing is approved. Even when true, every run also needs
# explicit confirmation that the document owner allowed sending files to the provider.
RAMVORA_AI_ENABLED=false
# (The pre-rebrand name QUILLVORA_AI_ENABLED is still accepted.)
# Credentials for the AI provider are read by the Anthropic SDK (e.g. ANTHROPIC_API_KEY).
# Store them only as secrets; never commit them.

# --- Backups (see BACKUP_RUNBOOK.md) --------------------------------------
# Turn on the in-app daily encrypted backup.
BACKUP_ENABLED=false
# Fernet key used ONLY for backups; must differ from API_KEY_ENCRYPTION_KEY.
# Store a copy outside Render (password manager). Without it backups are unreadable.
BACKUP_ENCRYPTION_KEY=
# Local copies (same disk as the DB; fast restores, NOT offsite).
BACKUP_DIR=/var/data/backups
# BACKUP_INTERVAL_HOURS=24
# BACKUP_FIRST_DELAY_MINUTES=10
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_MONTHLY=12
# Offsite S3-compatible storage (AWS S3, Backblaze B2, Cloudflare R2, ...).
# Use write-only credentials; enforce offsite retention with bucket lifecycle rules.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=ramvora/
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# --- Optional tuning (defaults shown) ------------------------------------
# DEFAULT_MONTHLY_LIMIT=1000
# REQUESTS_PER_MINUTE=60
# MAX_UPLOAD_BYTES=15728640
# MAX_WEBHOOK_BODY_BYTES=1048576
# MAX_JSON_BODY_BYTES=1048576      # all non-upload, non-webhook requests
# INVALID_KEY_RATE_LIMIT=30        # invalid API keys per client IP per minute
# MAX_PDF_PAGES=20
# MAX_OCR_PAGES=5
# MAX_IMAGE_PIXELS=25000000
# MAX_PDF_PAGE_PIXELS=16000000
# OCR_TIMEOUT_SECONDS=30
# OCR_LANGUAGES=eng+spa
# MAX_CONCURRENT_FILE_JOBS=1
# TESSERACT_CMD=
# Public endpoint throttles (per client IP):
# CHECKOUT_RATE_LIMIT=5            # per hour
# RECOVERY_REQUEST_RATE_LIMIT=5    # per hour
# RECOVERY_CONFIRM_RATE_LIMIT=10   # per 10 minutes
# ADMIN_CREATE_KEY_RATE_LIMIT=10   # per hour (per admin client)
